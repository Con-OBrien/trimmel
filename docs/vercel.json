{
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.trimmel.app"
        }
      ],
      "destination": "https://trimmel.app/$1",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "trimmel.vercel.app"
        }
      ],
      "destination": "https://trimmel.app/$1",
      "permanent": true
    },
    {
      "source": "/downloads/Trimmel-Setup.exe",
      "destination": "https://github.com/Con-OBrien/trimmel/releases/latest/download/Trimmel-Setup.exe",
      "permanent": false
    },
    {
      "source": "/downloads/Trimmel-Portable.zip",
      "destination": "https://github.com/Con-OBrien/trimmel/releases/latest/download/Trimmel-Portable.zip",
      "permanent": false
    },
    {
      "source": "/downloads/PC-Optimizer-Setup.exe",
      "destination": "https://github.com/Con-OBrien/trimmel/releases/latest/download/Trimmel-Setup.exe",
      "permanent": true
    },
    {
      "source": "/downloads/PC-Optimizer-Portable.zip",
      "destination": "https://github.com/Con-OBrien/trimmel/releases/latest/download/Trimmel-Portable.zip",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/downloads/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    }
  ]
}
